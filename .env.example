# Copy to .env. Every setting in app/config.py can be overridden here.

# LLM: gemini (free key: https://aistudio.google.com/apikey) or groq (https://console.groq.com)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Live audio source + Whisper (tiny | base | small | medium)
# STREAM_URL=http://stream.live.vc.bbcmedia.co.uk/bbc_world_service
# CHUNK_DURATION_SECONDS=60
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
